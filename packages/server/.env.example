# Node/Docker runtime. On Cloudflare these come from wrangler.jsonc vars + secrets.
PORT=8787
SQLITE_PATH=data/openbean.db
APP_ORIGIN=http://localhost:8787

JWT_SECRET=change-me
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The one email allowed to create an account without an invite.
BOOTSTRAP_ADMIN_EMAIL=

S3_ENDPOINT=https://storage.googleapis.com
S3_BUCKET=openbean-photos
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAX_PHOTOS_PER_POST=20
