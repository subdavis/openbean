{
  "name": "openbean",
  "main": "src/worker.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    // Without this, Cloudflare's edge treats a full-page nav to /api/* (e.g. the OAuth
    // login link) as a SPA route and serves index.html instead of invoking the Worker.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbean-db",
      "database_id": "cd38d129-0d79-41d4-9538-590137486f05",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://beans.subdavis.com",
    "BOOTSTRAP_ADMIN_EMAIL": "davis.a.brandon@gmail.com",
    "S3_BUCKET": "photobucket.subdavis.com",
    "S3_ENDPOINT": "https://storage.googleapis.com",
    "S3_REGION": "auto",
    "MAX_PHOTOS_PER_POST": "20"
  },
  "routes": [{ "pattern": "beans.subdavis.com", "custom_domain": true }],
  "secrets": {
    "required": [
      "JWT_SECRET",
      "GOOGLE_OAUTH_CLIENT_ID",
      "GOOGLE_OAUTH_CLIENT_SECRET",
      "S3_ACCESS_KEY_ID",
      "S3_SECRET_ACCESS_KEY"
    ]
  }
}
