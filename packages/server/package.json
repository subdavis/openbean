{
  "name": "@openbean/server",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler d1 migrations apply openbean-db --remote && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.14",
    "@openbean/shared": "workspace:*",
    "hono": "^4",
    "jose": "^5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@types/node": "^24",
    "typescript": "^5",
    "wrangler": "^4"
  }
}
